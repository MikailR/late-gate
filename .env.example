# Late Gate — copy to `.env.local`. Do not put real secrets in git.

# App
BASE_URL=http://127.0.0.1:47210
DEMO_MODE=1
WORKER_KEY=
FLIGHT_DATA_MODE=demo
AVIATIONSTACK_KEY=

# ---------------------------------------------------------------------------
# Prize till — USDC on World Chain Sepolia (LOCKED)
# Demo/testnet only. Chain id 4801. Do not target mainnet (480).
# Mikail fills: WORLDCHAIN_RPC + Circle faucet USDC + HOUSE_EVM_PRIVATE_KEY.
# Faucet: https://faucet.circle.com
# Public RPC (docs): https://worldchain-sepolia.g.alchemy.com/public
# Testnet USDC (Circle / World, verified 2026-09-13):
#   0x66145f38cBAC35Ca6F1Dfb4914dF98F1614aeA88
# Mainnet USDC (docs only, do not target):
#   0x79A02482A880bCE3F13e09Da970dC34db4CD24d1
#
# Live ERC-20 sends unlock only when ALL THREE are set:
#   WORLDCHAIN_RPC + HOUSE_EVM_PRIVATE_KEY + LP_VAULT_ADDRESS
# Missing any one keeps stub receipts (implemented:false).
# Deploy the vault, then paste the address:
#   WORLDCHAIN_RPC=... HOUSE_EVM_PRIVATE_KEY=... npm run deploy:vault
# ---------------------------------------------------------------------------
WORLDCHAIN_RPC=
WORLDCHAIN_CHAIN_ID=4801
USDC_ADDRESS=0x66145f38cBAC35Ca6F1Dfb4914dF98F1614aeA88
HOUSE_EVM_PRIVATE_KEY=
LP_VAULT_ADDRESS=

# ---------------------------------------------------------------------------
# Demo fallback pot (memory). NOT the locked prize path.
# Redis / Upstash leftover — policies + bindings only. Do not treat as prize money.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEMO_POT_GRANT_CENTS=5000
# Demo inventory (default 5). Live default is 10 stubs / flight / product.
HOUSE_MAX_OPEN_PER_FLIGHT=5

# ---------------------------------------------------------------------------
# World — Sandbox IDKit + server verify. This is the path we can ship.
#
# Selfie Check (Beta) is access-gated. World docs + Discord: email
# developers@toolsforhumanity.com so TFH can enable the app flag.
# ETHOnline teams cannot self-enable it. Do not set selfieCheckLegacy and
# claim live selfie proofs until that flag is on. Sandbox can still run
# IDKit + POST /api/world/verify; production Selfie Check cannot.
#
#   WORLD_ENV=sandbox              IDKit environment we can actually use
#   WORLD_PRESET=orbLegacy         shippable default (Orb / World ID 3.0)
#   WORLD_PRESET=selfieCheckLegacy only after TFH enables the flag
#   WORLD_ACTION=late-gate-ticket  uniqueness action (keep this)
#
# Empty APP_ID / RP_ID → deterministic stub nullifier so ticket issue
# still works locally. Live v4 verify needs both IDs, then still only
# orbLegacy until the Selfie flag lands.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# Server-only on this repo (rails). Never NEXT_PUBLIC. Never late-gate-app.
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=late-gate-ticket
WORLD_ENV=sandbox
WORLD_SESSION_SECRET=
WORLD_PRESET=orbLegacy

