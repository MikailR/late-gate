# Late Gate — copy to `.env.local`. Do not put real secrets in git.

# App
BASE_URL=http://127.0.0.1:47210
DEMO_MODE=1
WORKER_KEY=
FLIGHT_DATA_MODE=demo
AVIATIONSTACK_KEY=

# ---------------------------------------------------------------------------
# Human till (USD pot) — Redis / Upstash
# Never reuse these as Hedera / HBAR credentials.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEMO_POT_GRANT_CENTS=5000
# Demo inventory (default 5). Live default is 10 stubs / flight / product.
HOUSE_MAX_OPEN_PER_FLIGHT=5

# ---------------------------------------------------------------------------
# Machine till (HBAR / x402 via Blocky402) — Hedera testnet, native, no bridge
# Never reuse these as USD pot credentials.
# Portal accounts only (portal.hedera.com). EVM-faucet hollow accounts cannot sign.
# ---------------------------------------------------------------------------
BLOCKY402_URL=https://api.testnet.blocky402.com
HOUSE_HEDERA_ACCOUNT_ID=
HOUSE_HEDERA_PRIVATE_KEY=
HCS_TOPIC_ID=
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
X402_SNAPSHOT_TINYBAR=100000
X402_RECEIPT_TINYBAR=500000

# ---------------------------------------------------------------------------
# World — Selfie Check (server verify). orbLegacy until TFH enables the flag.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=late-gate-ticket
WORLD_ENV=sandbox
WORLD_SESSION_SECRET=
WORLD_PRESET=orbLegacy

# ---------------------------------------------------------------------------
# Base Sepolia — LateGateLedger dual-write (The Graph Studio)
# House is the only writer. Traveler never signs.
# ---------------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
HOUSE_EVM_PRIVATE_KEY=
LEDGER_ADDRESS=
SUBGRAPH_URL=
GRAPH_API_KEY=
